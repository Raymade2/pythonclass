# SQLite database location (Node built-in driver — no native deps required).
# For a PostgreSQL deployment, swap lib/db.ts with a Postgres connection and
# port the DDL in lib/ddl.ts.
SQLITE_PATH="data/sfgs.db"

# Payment gateway secrets (server-side only — NEVER exposed to the frontend).
# When set, online checkout uses the real gateway; otherwise the built-in demo
# gateway simulator is used so the payment flow can be tested end to end.
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""

# Base URL of the app (used for gateway callbacks)
APP_URL="http://localhost:3000"
